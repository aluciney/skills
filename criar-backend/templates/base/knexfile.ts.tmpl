import { format } from 'date-fns'
import type { Knex } from 'knex'
import { env } from '@/env'

const config: Knex.Config = {
	client: 'oracledb',
	wrapIdentifier: (value, origImpl) => origImpl(value === '*' ? value : value.toUpperCase()),
	pool: { min: 0, max: 1 },
	acquireConnectionTimeout: 15000,
	postProcessResponse: (result) => {
		const formatDate = (val: any) => {
			if (val instanceof Date) {
				return format(val, 'yyyy-MM-dd HH:mm:ss')
			}
			return val
		}
		const processRow = (row: any) => {
			const obj: any = {}
			for (const key in row) {
				const ignorePagination = ['total', 'perPage', 'currentPage', 'from', 'to', 'total', 'lastPage', 'prevPage', 'nextPage']
				if (ignorePagination.includes(key)) {
					obj[key] = formatDate(row[key])
				} else {
					const lowerKey = key.toLowerCase()
					obj[lowerKey] = formatDate(row[key])
				}
			}
			return obj
		}
		if (Array.isArray(result)) {
			if (result.length && typeof result[0] !== 'object') {
				return result.map((val) => formatDate(val))
			}
			return result.map(processRow)
		}
		if (typeof result === 'object' && result !== null) {
			return processRow(result)
		}
		return result
	},
}

export const knexfile: { {{db}}: Knex.Config } = {
	{{db}}: {
		client: 'oracledb',
		connection: {
			host: env.DB_HOST_{{DB}},
			database: env.DB_NAME_{{DB}},
			user: env.DB_USER_{{DB}},
			password: env.DB_PASS_{{DB}},
			port: env.DB_PORT_{{DB}},
			charset: 'utf8',
		},
		...config,
	},
}
